{
    "$schema": "https://unpkg.com/knip@latest/schema.json",
    "entry": [
        "src/apps/*/main.ts",
        "src/apps/*/services/index.ts",
        "src/apps/*/domains/*/index.ts",
        "src/tests/**/*.spec.ts"
    ],
    "project": ["src/**/*.ts", "src/**/*.vue"],
    "paths": {"@/*": ["src/*"], "@shared/*": ["src/shared/*"], "@app/*": ["src/apps/families/*", "src/apps/admin/*"]},
    "ignore": ["src/**/*.d.ts"],
    "ignoreDependencies": [
        "@typescript/native-preview",
        "@vitest/browser",
        "@commitlint/cli",
        "lint-staged",
        "@stryker-mutator/api"
    ]
}
