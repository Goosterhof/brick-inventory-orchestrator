# Backend
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=brick_inventory
DB_USERNAME=brick_inventory
DB_PASSWORD=secret
DB_SSLMODE=disable

# External APIs
REBRICKABLE_API_KEY=your_rebrickable_api_key_here

# Cross-surface URL (consumed by backend/config/app.php for cookie/CORS scoping)
FRONTEND_URL=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
