#!/usr/bin/env bash
# Monorepo pre-push dispatcher.
#
# Inspect the pushed range and run each surface's pre-push gauntlet only
# when that surface has files in the range:
#   - backend/  → CaptainHook (PrePushPermitGate → composer test). The
#     gate reads stdin per git's pre-push protocol, so we pipe our
#     buffered stdin through unchanged.
#   - frontend/ → Husky's pre-push script (type-check → knip → test:coverage → build).

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Resolve the shared git directory in a worktree-safe way. In a linked
# worktree, `.git` at the worktree root is a FILE pointing at
# <main>/.git/worktrees/<name>, so a `--git-directory=../.git` (relative to
# backend/) pointed CaptainHook at a path that is not a directory. The common
# dir is the real shared `.git` regardless of worktree vs main checkout; in a
# main checkout it resolves to the same `$repo_root/.git` the old form used.
git_common_dir=$(git rev-parse --git-common-dir)
case "$git_common_dir" in
    /*) ;;
    *) git_common_dir="$repo_root/$git_common_dir" ;;
esac

# git invokes pre-push with one line per pushed ref on stdin:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
# Buffer it so we can both inspect the range AND replay it into the
# delegated hook.
stdin_buffer=$(cat || true)

needs_backend=0
needs_frontend=0

if [ -n "$stdin_buffer" ]; then
    while IFS=' ' read -r _local_ref local_sha _remote_ref remote_sha; do
        [ -z "${local_sha:-}" ] && continue
        # Skip ref deletes (all-zero local sha).
        [[ "$local_sha" =~ ^0+$ ]] && continue

        if [[ "${remote_sha:-}" =~ ^0+$ ]] || [ -z "${remote_sha:-}" ]; then
            # New branch on the remote — diff against the merge-base with origin/main.
            base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
            if [ -n "$base" ]; then
                range="$base..$local_sha"
            else
                range="$local_sha"
            fi
        else
            range="$remote_sha..$local_sha"
        fi

        changed=$(git diff --name-only "$range" 2>/dev/null || true)
        if grep -qE '^backend/' <<< "$changed"; then
            needs_backend=1
        fi
        if grep -qE '^frontend/' <<< "$changed"; then
            needs_frontend=1
        fi
    done <<< "$stdin_buffer"
fi

if [ "$needs_backend" -eq 1 ]; then
    echo "→ backend changes in push range; running backend pre-push gauntlet"
    # --git-directory points at the shared .git/ (resolved worktree-safely
    # above) — captainhook would otherwise look for backend/.git/ which
    # doesn't exist in the monorepo (the only git directory is at the
    # orchestrator root).
    (cd backend && printf '%s\n' "$stdin_buffer" | vendor/bin/captainhook hook:pre-push --git-directory="$git_common_dir")
fi

if [ "$needs_frontend" -eq 1 ]; then
    echo "→ frontend changes in push range; running frontend pre-push gauntlet"
    (cd frontend && bash .husky/pre-push)
fi

exit 0
