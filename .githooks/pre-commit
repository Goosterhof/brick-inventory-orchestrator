#!/usr/bin/env bash
# Pre-commit: fix the STAGED files, then re-stage them (ADR-0028 Amendment 2, light hooks).
#
# Whole-tree checks (Rector, PHPStan, Deptrac, the architecture suite) and the test suites are not
# here: CI's `gate` is the floor for them, and pre-push runs the type checkers. CLAUDE.md
# § Git Hooks says where each gate runs.

set -uo pipefail

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

# Under WSL a non-interactive PATH can find the Windows node/npm first, which dies on a CMD.EXE
# error that reads like a lint failure. Prefer the newest nvm node then.
for tool in node npm; do
    case "$(command -v "$tool" 2>/dev/null)" in
        "" | /mnt/*)
            nvm_bin=$(ls -d "$HOME"/.nvm/versions/node/*/bin 2>/dev/null | sort -V | tail -1)
            if [ -n "$nvm_bin" ]; then
                PATH="$nvm_bin:$PATH"
                export PATH
            fi
            break
            ;;
    esac
done

failed=0

# Staged paths are split on whitespace below; never glob them.
set -f

# Backend: pint on the staged PHP, from backend/ so pint.json's in-tree cache-file resolves.
#
# A file that ALSO has unstaged changes is checked, never written: `git add` after a write would
# sweep those hunks into the commit. `pint --test` reads the working-tree file, so for such a file
# it approximates the staged content; CI's `pint:test` checks the committed tree exactly.
#
# Pint formats every path it is handed, skipping its own finder: `*.blade.php`, `_ide_helper*.php`,
# storage/ and every pint.json `exclude` / `notPath` / `notName` would be rewritten. So the hook
# asks that finder which staged files it formats — the intersection `pint --dirty` makes — and
# hands Pint only those. An empty finder is a broken probe, never "nothing to format".
pint_finder='
    Phar::loadPhar("vendor/laravel/pint/builds/pint", "pint.phar");
    require "phar://pint.phar/vendor/autoload.php";
    $app = require "phar://pint.phar/bootstrap/app.php";
    $app->instance(
        App\Repositories\ConfigurationJsonRepository::class,
        new App\Repositories\ConfigurationJsonRepository(getcwd() . "/pint.json", null),
    );
    $formatted = [];
    foreach (App\Factories\ConfigurationFactory::finder()->in(getcwd())->files() as $file) {
        $formatted[$file->getPathname()] = true;
    }
    if ($formatted === []) {
        fwrite(STDERR, "Pint finder returned no files under " . getcwd() . "\n");
        exit(1);
    }
    foreach (array_slice($argv, 1) as $path) {
        if (isset($formatted[getcwd() . "/" . $path])) {
            echo $path, "\n";
        }
    }
'
staged_php=$(git diff --cached --name-only --diff-filter=ACMR -- 'backend/*.php')
if [ -n "$staged_php" ]; then
    staged_rel=""
    for f in $staged_php; do
        staged_rel="$staged_rel ${f#backend/}"
    done

    if [ ! -x backend/vendor/bin/pint ]; then
        echo "[skip] pint — backend/vendor/ is missing; run: composer install -d backend" >&2
    elif ! pint_rel=$(cd backend && php -d display_errors=stderr -r "$pint_finder" $staged_rel); then
        echo "✗ Could not ask Pint which staged files it formats, so pint did not run." >&2
        failed=1
    else
        whole=""
        partial=""
        for rel in $pint_rel; do
            if git diff --quiet -- "backend/$rel"; then
                whole="$whole $rel"
            else
                partial="$partial $rel"
            fi
        done

        if [ -n "$whole" ]; then
            echo "=== pint: staged PHP ==="
            if (cd backend && vendor/bin/pint $whole); then
                (cd backend && git add -- $whole) || failed=1
            else
                failed=1
            fi
        fi

        if [ -n "$partial" ]; then
            echo "=== pint --test: partially staged PHP ==="
            if ! (cd backend && vendor/bin/pint --test $partial); then
                echo "These backend/ files have unstaged changes and need formatting:$partial" >&2
                echo "Stage or stash the rest first, then commit again." >&2
                failed=1
            fi
        fi
    fi
fi

# Frontend: regenerate the component registry, then lint-staged on the staged files under frontend/
# (config in frontend/package.json).
#
# `--relative`: lint-staged runs from frontend/, and its globs must match the paths git emits
# relative to that cwd. `--concurrent false`: `*.{ts,vue}` and `*.vue` both match a .vue file, so
# its tasks run in order and no two tools touch one file at once.
#
# `--no-stash`: lint-staged's own backup lives in refs/stash, which every worktree of this repo
# shares, and it drops that backup by INDEX — a stash pushed from another worktree in between shifts
# the index onto someone else's entry. The hook keeps the backup itself: `git stash create` makes
# the commit without touching refs/stash, and refs/worktree/ is private to this worktree. A failed
# run names that ref, so an unstaged edit lint-staged could not put back is recoverable.
if [ -n "$(git diff --cached --name-only --diff-filter=ACMR -- frontend/)" ]; then
    if [ ! -x frontend/node_modules/.bin/lint-staged ]; then
        echo "[skip] lint-staged — frontend/node_modules/ is missing; run: npm ci --prefix frontend" >&2
    else
        case "$(command -v node 2>/dev/null)" in
            "" | /mnt/*)
                echo "✗ No Linux node on PATH, so the frontend checks could not run. Install node in WSL (nvm)." >&2
                failed=1
                ;;
            *)
                echo "=== component registry ==="
                # `git -C "$repo_root" add frontend/...` names the path from the root: a bare
                # `git add src/...` from a frontend/ cwd staged a spurious root file in worktree mode.
                if ! (cd frontend &&
                    node scripts/generate-component-registry.mjs &&
                    ./node_modules/.bin/oxfmt --write src/shared/generated/component-registry.json &&
                    git -C "$repo_root" add frontend/src/shared/generated/component-registry.json); then
                    failed=1
                elif ! backup=$(git stash create); then
                    echo "✗ Could not back up the working tree, so lint-staged did not run." >&2
                    failed=1
                elif [ -n "$backup" ] && ! git update-ref refs/worktree/lint-staged-backup "$backup"; then
                    echo "✗ Could not save refs/worktree/lint-staged-backup, so lint-staged did not run." >&2
                    failed=1
                elif (cd frontend && ./node_modules/.bin/lint-staged --relative --concurrent false --no-stash --quiet); then
                    if [ -n "$backup" ]; then
                        git update-ref -d refs/worktree/lint-staged-backup
                    fi
                else
                    failed=1
                    if [ -n "$backup" ]; then
                        echo "  The state before lint-staged ran is saved as $backup (refs/worktree/lint-staged-backup)." >&2
                        echo "  If an unstaged edit did not come back, restore it all with:" >&2
                        echo "    git reset --hard && git stash apply --index $backup" >&2
                    fi
                fi
                ;;
        esac
    fi
fi

if [ "$failed" -ne 0 ]; then
    echo "" >&2
    echo "✗ pre-commit failed. Fix the errors above and commit again." >&2
    exit 1
fi
