#!/usr/bin/env bash
# Monorepo pre-commit dispatcher.
#
# Staged paths under backend/ run backend's CaptainHook pre-commit gauntlet
# (lint:test → phpstan → phpstan:types → deptrac → test:arch).
# Staged paths under frontend/ run frontend's pre-commit pipeline:
# regenerate the component registry, format the generated file, restage
# it, then run lint-staged with --relative so its patterns match the
# staged-path slice that git emits from frontend/ cwd in a monorepo.
# Other staged paths bypass both — the orchestrator itself has no hook.

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_backend=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^backend/' || true)
staged_frontend=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^frontend/' || true)

if [ -n "$staged_backend" ]; then
    echo "→ backend changes staged; running backend pre-commit gauntlet"
    # CaptainHook takes dirname(--git-directory) as the repository ROOT and
    # verifies it with `is_dir(root/.git) || is_file(root/.git)` — so the
    # flag must name the `.git` entry AT the repo root (directory in a
    # standalone clone, `gitdir:` pointer file in a worktree or submodule),
    # never the resolved common dir. Passing the common dir made the root
    # `.git/modules/<parent>` and refused every backend commit from a
    # submodule checkout with "Invalid git repository".
    (cd backend && vendor/bin/captainhook hook:pre-commit --git-directory="$repo_root/.git")
fi

if [ -n "$staged_frontend" ]; then
    echo "→ frontend changes staged; running frontend pre-commit pipeline"
    # Anchor cwd and git-add against $repo_root (set above via `git rev-parse
    # --show-toplevel`). In worktree-mode dispatches a bare `git add
    # src/shared/generated/component-registry.json` from a `cd frontend` cwd
    # has been observed to stage a spurious orchestrator-root file
    # (`src/shared/...` instead of `frontend/src/shared/...`); see the
    # 2026-05-27 BR `worktree-mode-pre-commit-hook-regression`. The
    # `git -C "$repo_root" add frontend/src/...` form makes the staged path
    # explicit and worktree-safe.
    (cd "$repo_root/frontend" && \
        node scripts/generate-component-registry.mjs && \
        npx oxfmt --write src/shared/generated/component-registry.json && \
        git -C "$repo_root" add frontend/src/shared/generated/component-registry.json && \
        npx lint-staged --relative)
fi

exit 0
