#!/usr/bin/env bash
# Monorepo pre-commit dispatcher.
#
# Staged paths under backend/ run backend's CaptainHook pre-commit gauntlet
# (lint:test → phpstan → phpstan:types → deptrac → test:arch).
# Staged paths under frontend/ run frontend's pre-commit pipeline:
# regenerate the component registry, format the generated file, restage
# it, then run lint-staged with --relative so its patterns match the
# staged-path slice that git emits from frontend/ cwd in a monorepo.
# Other staged paths bypass both — the orchestrator itself has no hook.

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_backend=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^backend/' || true)
staged_frontend=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^frontend/' || true)

if [ -n "$staged_backend" ]; then
    echo "→ backend changes staged; running backend pre-commit gauntlet"
    (cd backend && vendor/bin/captainhook hook:pre-commit)
fi

if [ -n "$staged_frontend" ]; then
    echo "→ frontend changes staged; running frontend pre-commit pipeline"
    (cd frontend && \
        node scripts/generate-component-registry.mjs && \
        npx oxfmt --write src/shared/generated/component-registry.json && \
        git add src/shared/generated/component-registry.json && \
        npx lint-staged --relative)
fi

exit 0
