{
    "permissions": {
        "allow": [
            "Write(.claude/records/**)",
            "Edit(.claude/records/**)",
            "Write(.claude/docs/**)",
            "Edit(.claude/docs/**)",
            "Edit(.claude/agents/*-graduation.md)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/guard-generated-files.sh",
                        "timeout": 5,
                        "statusMessage": "Checking for generated file edits..."
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/guard-destructive-git.sh",
                        "if": "Bash(git *)",
                        "timeout": 5,
                        "statusMessage": "Checking for destructive git commands..."
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/check-formatting.sh",
                        "timeout": 15,
                        "statusMessage": "Checking formatting..."
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .claude/hooks/session-start-check.sh",
                        "timeout": 600,
                        "statusMessage": "Checking build environment..."
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "if [ -n \"$(git status --porcelain .claude/records/minutes/ 2>/dev/null)\" ]; then git add .claude/records/minutes/ && git commit -m 'docs: auto-commit session minutes'; fi",
                        "timeout": 15,
                        "statusMessage": "Auto-committing minutes..."
                    }
                ]
            }
        ]
    }
}
