# DB_ENCRYPT=
# DB_TRUST_SERVER_CERTIFICATE=
# MYSQL_ATTR_SSL_CA=

# PostgreSQL (Railway production)
# DB_CONNECTION=pgsql
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# SESSION_CONNECTION=
# SESSION_TABLE=sessions
# SESSION_STORE=
# SESSION_EXPIRE_ON_CLOSE=false
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax
# SESSION_PARTITIONED_COOKIE=false

# SANCTUM_TOKEN_PREFIX=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# QUEUE_FAILED_DRIVER=database-uuids
# DB_QUEUE_CONNECTION=
# DB_QUEUE_TABLE=jobs
# DB_QUEUE=default
# INVARIANT: DB_QUEUE_RETRY_AFTER must strictly exceed the largest #[Timeout] in
# app/Jobs (currently 600s), or a long-running job's reservation is released
# mid-run and a second worker executes it concurrently (duplicate imports).
# Guarded by tests/Architecture/QueueRetryAfterArchitectureTest.php.
# DB_QUEUE_RETRY_AFTER=700
# BEANSTALKD_QUEUE_HOST=localhost
# BEANSTALKD_QUEUE=default
# BEANSTALKD_QUEUE_RETRY_AFTER=90
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=90
# SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
# SQS_QUEUE=default
# SQS_SUFFIX=

CACHE_STORE=database
# CACHE_PREFIX=
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=
# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=

MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_PERSISTENT_ID=

