APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# APP_PREVIOUS_KEYS=
# Set to true for local development only
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# AUTH_GUARD=web
# AUTH_MODEL=App\Models\User
# AUTH_PASSWORD_BROKER=users
# AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# AUTH_PASSWORD_TIMEOUT=10800

# PHP_CLI_SERVER_WORKERS=4

OCTANE_SERVER=frankenphp
# OCTANE_HTTPS=true
# FRANKENPHP_MAX_REQUESTS=500

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug
# LOG_DAILY_DAYS=14
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME="Laravel Log"
# LOG_SLACK_EMOJI=":boom:"
# LOG_PAPERTRAIL_HANDLER=Monolog\Handler\SyslogUdpHandler
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=
# LOG_STDERR_FORMATTER=
# LOG_SYSLOG_FACILITY=LOG_USER

FRONTEND_URL=http://localhost:5173
FRONTEND_URL_PRODUCTION=
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173

BRICKOGNIZE_BASE_URL=https://api.brickognize.com

INVITE_CODE_TTL_DAYS=7

DB_CONNECTION=sqlite
# DB_URL=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_SOCKET=
